<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.lostfound.mapper.CommentMapper">

    <resultMap id="CommentMap" type="com.campus.lostfound.entity.Comment">
        <id property="id" column="id"/>
        <result property="goodsId" column="goods_id"/>
        <result property="content" column="content"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="nickname" column="nickname"/>
        <result property="username" column="username"/>
    </resultMap>

    <select id="findByGoodsId" resultMap="CommentMap">
        SELECT c.*, u.nickname, u.username
        FROM comment c LEFT JOIN user u ON c.user_id = u.id
        WHERE c.goods_id = #{goodsId}
        ORDER BY c.create_time DESC
    </select>

    <insert id="insert" parameterType="com.campus.lostfound.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment(goods_id, content, user_id, create_time)
        VALUES(#{goodsId}, #{content}, #{userId}, NOW())
    </insert>

    <delete id="delete">
        DELETE FROM comment WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM comment
    </select>
</mapper>
